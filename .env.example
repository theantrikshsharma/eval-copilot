# Supabase Configuration
# Obtain URL and Service Role Key from your Supabase project dashboard (Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: Groq API Key (only if semantic LLM judge is enabled)
# GROQ_API_KEY=gsk_...
