# Supabase Configuration
# Obtain URL and Service Role Key from your Supabase project dashboard (Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: LLM judge (openai/gpt-oss-120b on Groq). Resolves NEEDS REVIEW checks. Skipped when unset.
# GROQ_API_KEY=gsk_...

# Optional: Content safety check (nvidia/nemotron-3.5-content-safety on OpenRouter). Skipped when unset.
# OPENROUTER_API_KEY=sk-or-v1-...
