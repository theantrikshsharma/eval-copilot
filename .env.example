# Supabase Configuration
# Obtain URL and Service Role Key from your Supabase project dashboard (Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: LLM judge (openai/gpt-oss-120b on Groq). Resolves NEEDS REVIEW checks. Skipped when unset.
# GROQ_API_KEY=gsk_...

# Optional: semantic content safety (nvidia/nemotron-3.5-content-safety on OpenRouter).
# Off unless BOTH are set, so routine runs never depend on it. The free tier allows about 50 requests/day;
# once it reports the daily quota exhausted, MANTIS stops calling until 00:00 UTC.
# OPENROUTER_API_KEY=sk-or-v1-...
# MANTIS_SEMANTIC_SAFETY=1
