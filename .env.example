# Supabase (durable storage; required for a hosted deployment, optional locally)
# Project Settings -> API. Use the service_role key: schema.sql enables Row Level Security, so the anon key
# can neither read nor write. Keep this key server-side only.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Admin token for adding cases. Running existing cases needs no token, but runs without it are limited per
# target (MANTIS_OPEN_RUNS_PER_MINUTE, default 5). Required on a hosted deployment, where case creation is
# refused without it. Optional locally.
# MANTIS_ADMIN_TOKEN=a-long-random-string
# MANTIS_OPEN_RUNS_PER_MINUTE=5

# LLM judge (openai/gpt-oss-120b on Groq). Decides checks the deterministic rules can't; without it those
# checks stay NEEDS REVIEW and say "Judge not run".
# GROQ_API_KEY=gsk_...

# Optional: semantic content safety (nvidia/nemotron-3.5-content-safety on OpenRouter).
# Off unless BOTH are set, so routine runs never depend on it. The free tier allows about 50 requests/day;
# once it reports the daily quota exhausted, MANTIS stops calling until 00:00 UTC.
# OPENROUTER_API_KEY=sk-or-v1-...
# MANTIS_SEMANTIC_SAFETY=1

# Optional overrides
# MANTIS_SQLITE_PATH=/path/to/history.db   # local SQLite file (default: eval_copilot.db in the project)
# MANTIS_CLASSIC_UI=0                       # don't mount the legacy Gradio view at /classic
